# server
PORT=3000
NODE_ENV=development
DATA_DIR=./data
PUBLIC_URL=https://your-domain.uz
JWT_SECRET=change-this-to-a-random-64-character-or-longer-secret
ADMIN_EMAIL=admin@your-domain.uz
ADMIN_PASSWORD=change-this-to-a-unique-12-plus-character-password

# Payme Business — REAL MERCHANT keys, NOT demo credentials.
# In Payme Business merchant account, set account field to: order_id
# Set merchant billing callback URL to: https://your-domain.uz/api/payments/payme
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# WebRTC: TURN credentials recommended for production (STUN only may fail behind NAT)
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# Gemini AI, optional
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
