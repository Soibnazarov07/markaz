# server
PORT=3000
NODE_ENV=development
DATA_DIR=./data
PUBLIC_URL=https://your-domain.uz
JWT_SECRET=change-this-to-a-random-64-character-or-longer-secret
ADMIN_EMAIL=admin@your-domain.uz
ADMIN_PASSWORD=change-this-to-a-unique-12-plus-character-password

# To‘lovlar faqat administrator/buxgalter tomonidan qo‘lda qayd qilinadi.
# Click/Uzum/Payme merchant kalitlari talab etilmaydi.

# WebRTC: TURN credentials recommended for production (STUN only may fail behind NAT)
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# Gemini AI, optional
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Faqat bir martalik CLI super admin yaratish uchun; GitHubga yoki chatga qiymatini yubormang.
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=

# V8: faqat tashqi monitoring servisi uchun
# HEALTH_URL=https://your-actual-domain.up.railway.app/api/health
# BACKUP_RETENTION=7
